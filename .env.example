# Football Value & Probability Analyzer
# Environment configuration — copy to .env and fill in your keys

# ── Data provider keys ──────────────────────────────────────────────────────
# Football-Data.org (free tier — 10 req/min, major leagues)
# Register at: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_football_data_key_here

# The Odds API (free tier — 500 req/month)
# Register at: https://the-odds-api.com/
ODDS_API_KEY=your_odds_api_key_here

# ── Cache ────────────────────────────────────────────────────────────────────
CACHE_DB_PATH=football_agent_cache.db
CACHE_ENABLED=true

# ── Margin removal ───────────────────────────────────────────────────────────
# Options: proportional | shin | power | additive
DEFAULT_MARGIN_METHOD=shin

# ── Model weights (overridden by walk-forward calibration when available) ────
DIXON_COLES_WEIGHT=0.55
ELO_WEIGHT=0.45

# ── Kelly staking ────────────────────────────────────────────────────────────
KELLY_FRACTION=0.25
MAX_STAKE_PCT_OF_BANKROLL=0.02
MAX_DAILY_EXPOSURE_PCT=0.05

# ── Edge thresholds ──────────────────────────────────────────────────────────
MIN_EDGE_PCT_FOR_VALUE_CANDIDATE=0.03
MIN_EV_FOR_VALUE_CANDIDATE=0.02

# ── Output ───────────────────────────────────────────────────────────────────
DEFAULT_TIMEZONE=UTC
DEFAULT_CURRENCY=USD
DEFAULT_LANGUAGE=en
